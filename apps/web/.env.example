# 프론트엔드(Vite) 환경변수 — VITE_ 접두사만 클라이언트에 노출됨.
# 로컬: 이 파일을 .env 로 복사해서 값 채우기. 배포: Vercel 환경변수에 등록.

# Supabase 프로젝트 (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# 백엔드 API (로컬: http://127.0.0.1:3000 / 배포: Render URL)
VITE_API_URL=https://family-finance-api.onrender.com

# Web Push 공개키 (서버 VAPID_PUBLIC_KEY와 동일값. private는 절대 넣지 말 것)
VITE_VAPID_PUBLIC_KEY=

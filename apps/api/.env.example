# 백엔드(Fastify) 환경변수 — 서버 전용. 절대 클라이언트에 노출 금지.
# 로컬: 이 파일을 .env 로 복사해서 값 채우기. 배포: Render 환경변수에 등록.

# 로컬 기본값 (배포 시 Render가 PORT 자동 주입 → API_PORT 생략 가능, API_HOST=0.0.0.0)
API_PORT=3000
API_HOST=127.0.0.1

# Supabase (service_role은 서버 전용 — RLS 우회 권한, 유출 시 전체 데이터 노출)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# CORS — 배포 프론트 도메인(쉼표 구분). 로컬 5173은 항상 허용됨.
CORS_ORIGINS=https://family-finance.vercel.app

# Web Push (pnpm exec web-push generate-vapid-keys --json 로 생성)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Supabase Local (supabase start 후 출력되는 값과 동일)
# 클라우드로 갈 때만 변경
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API
API_PORT=3000
API_HOST=127.0.0.1

# Web
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:3000

# Web Push VAPID (로컬용 키, 첫 실행 시 생성 명령은 README 참조)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@local
